{
  // Configuración de la aplicación. ASP.NET Core la carga por capas que se
  // SOBRESCRIBEN en este orden (la última gana):
  //   appsettings.json -> appsettings.{Entorno}.json -> variables de entorno -> argumentos
  // Así, en producción puedes cambiar la cadena de conexión con una variable de
  // entorno (ConnectionStrings__Database) sin tocar ningún archivo.
  //
  // NUNCA guardes secretos (contraseñas, claves de API) en este archivo: va al
  // repositorio. En desarrollo se usa "dotnet user-secrets" y en producción,
  // variables de entorno o un gestor de secretos. Aquí no hay ningún secreto.

  "ConnectionStrings": {
    // Oracle: usuario de la aplicación sin contraseña. La contraseña se agrega
    // por variable de entorno en cada ambiente.
    "Database": "User Id=APP_CATALOGO;Data Source=//oracle-dev.empresa.local:1521/CATALOGO"
  },

  "ProcesosBatch": {
    // Nombre completo del procedimiento de cierre mensual. Cambia según el
    // ambiente, así que se define con la variable ProcesosBatch__CierreMensual.
    "CierreMensual": ""
  },

  "Logging": {
    "LogLevel": {
      // Nivel mínimo que se escribe. De más a menos detalle:
      // Trace < Debug < Information < Warning < Error < Critical
      "Default": "Information",
      // El framework es muy hablador en Information; lo subimos a Warning para
      // que el ruido no tape NUESTROS mensajes.
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
