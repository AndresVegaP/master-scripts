# ═══════════════════════════════════════════════════════════════════
# .editorconfig — las reglas de estilo del equipo, versionadas en el repo.
#
# ¿Por qué importa? Clean Code empieza por la CONSISTENCIA: un código que
# siempre tiene la misma forma se lee sin fricción. Este archivo hace que
# el IDE (VS, VS Code, Rider) y `dotnet format` apliquen el mismo estilo
# a todo el mundo, sin discusiones en cada PR.
# ═══════════════════════════════════════════════════════════════════

# Este es el .editorconfig raíz (no buscar más arriba).
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.md]
# En Markdown los espacios finales tienen significado (salto de línea).
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# ── Organización de usings ──────────────────────────────────────────
# System primero, luego el resto, orden alfabético.
dotnet_sort_system_directives_first = true

# ── Estilo de código C# (convenciones de este repo) ─────────────────

# Namespaces de archivo (file-scoped): "namespace X;" sin llaves.
# Un nivel menos de indentación en TODO el archivo.
csharp_style_namespace_declarations = file_scoped:warning

# "var" cuando el tipo es evidente; explícito cuando aporta claridad.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Preferir miembros con cuerpo de expresión (=>) cuando son de una línea.
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion

# Llaves SIEMPRE, incluso en ifs de una línea: los bugs por "añadí una
# línea al if sin llaves" son un clásico.
csharp_prefer_braces = true:warning

# Preferencias modernas del lenguaje.
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

# ── Nomenclatura: interfaces empiezan por I ─────────────────────────
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = any_interface
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i

dotnet_naming_symbols.any_interface.applicable_kinds = interface
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_style.prefix_i.required_prefix = I

# ── Nomenclatura: campos privados con _guionBajo ────────────────────
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
