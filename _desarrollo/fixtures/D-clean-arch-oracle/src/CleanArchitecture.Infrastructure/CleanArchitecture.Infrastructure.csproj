<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure implementa los PUERTOS declarados en las capas interiores:
    los repositorios (definidos en Domain) y los puertos de lectura y de
    notificación (definidos en Application). Por eso referencia a Application,
    y a Domain por transitividad.

    Casi todo lo de esta capa es "internal": solo DependencyInjection es
    público. Así ningún endpoint puede saltarse el puerto y usar el repositorio
    concreto, ni siquiera por accidente. Un test de arquitectura lo verifica.
  -->

  <ItemGroup>
    <ProjectReference Include="..\CleanArchitecture.Application\CleanArchitecture.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los .sql largos viajan dentro del ensamblado; los carga SqlResources. -->
    <EmbeddedResource Include="Queries\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los tests de integración prueban los adaptadores reales, que son internal. -->
    <InternalsVisibleTo Include="CleanArchitecture.IntegrationTests" />
  </ItemGroup>

</Project>
