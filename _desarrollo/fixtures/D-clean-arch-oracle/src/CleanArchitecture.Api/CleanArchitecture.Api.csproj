<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Genera el archivo XML con los comentarios /// de este proyecto. .NET 10 lo
      usa para enriquecer el documento OpenAPI: los <summary>, <param> y
      <response code="..."> de los endpoints y de los contratos se convierten en
      descripciones dentro del JSON y, por tanto, en Swagger UI.

      Solo se activa en la Api: así la documentación pública de la API se
      escribe donde vive el contrato, y los comentarios didácticos de las capas
      interiores no se filtran a la especificación.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- No exigimos /// en absolutamente todos los miembros públicos. -->
    <!--
      CS1591: no exigimos /// en todos los miembros publicos.
      CS1573: en los endpoints documentamos solo los parametros que forman parte
      del contrato HTTP (la ruta y el cuerpo); los servicios que inyecta el
      contenedor no salen en la especificacion y documentarlos seria ruido.
    -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanArchitecture.Application\CleanArchitecture.Application.csproj" />
    <ProjectReference Include="..\CleanArchitecture.Infrastructure\CleanArchitecture.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Solo para la interfaz visual: el documento OpenAPI lo genera .NET. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los tests de integración arrancan esta aplicación en memoria. -->
    <InternalsVisibleTo Include="CleanArchitecture.IntegrationTests" />
  </ItemGroup>

</Project>
