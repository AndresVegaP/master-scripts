<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Los proyectos de test de xUnit v3 son PROGRAMAS EJECUTABLES: se pueden
      correr directamente (dotnet run) además de con dotnet test. Por eso
      OutputType es Exe.
    -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!--
      xUnit1051 pide pasar TestContext.Current.CancellationToken en cada llamada
      que acepte un token. Aquí no aporta: estos tests no hacen E/S real (todo
      son dobles en memoria) y añadir el token en cada línea sería ruido que
      tapa lo que el test quiere enseñar. En los tests de INTEGRACIÓN, donde sí
      hay base de datos y HTTP, el token se pasa siempre.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Un solo paquete: xunit.v3 trae el framework, las aserciones y el runner
      (Microsoft Testing Platform). El global.json de la raíz le dice a
      "dotnet test" que use ese runner.
    -->
    <PackageReference Include="xunit.v3" />
    <!-- Reloj falso para que los tests controlen el tiempo. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Los tests unitarios solo conocen las dos capas interiores. No pueden usar
      Dapper ni la API aunque quisieran: no están referenciados.
    -->
    <ProjectReference Include="..\..\src\CleanArchitecture.Domain\CleanArchitecture.Domain.csproj" />
    <ProjectReference Include="..\..\src\CleanArchitecture.Application\CleanArchitecture.Application.csproj" />
  </ItemGroup>

</Project>
