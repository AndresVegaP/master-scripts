{
  // Copia este archivo como "analisis.code-workspace" (esa extensión está en .gitignore),
  // ajusta las dos rutas y ábrelo con: Archivo > Abrir área de trabajo desde archivo...
  "folders": [
    {
      "name": "master-scripts (herramienta)",
      "path": "C:/ruta/a/master-scripts"
    },
    {
      "name": "repo-a-analizar",
      "path": "C:/ruta/al/repo-de-la-api"
    }
  ],
  "settings": {
    "files.encoding": "utf8",
    "[powershell]": {
      "files.encoding": "utf8bom"
    }
  }
}
